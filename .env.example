# Optional environment configuration. Keys entered in the UI take precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Required only for SEC EDGAR access. Include an application name and contact email.
SEC_USER_AGENT=FinancialAnalystAgent/1.0 contact@example.com

# Optional transcript enhancement. Core analysis does not require this.
FMP_API_KEY=

REQUEST_TIMEOUT_SECONDS=20
RETRY_COUNT=2
UPLOAD_SIZE_LIMIT_MB=10
